# Xen xl.conf 기본 설정 템플릿
# Ubuntu 22.04/24.04 LTS 최적화 설정

# 자동 메모리 밸런싱
# "auto": Dom0가 필요에 따라 메모리를 자동으로 조정
# "0": 비활성화 (고정 메모리 할당)
autoballoon="auto"

# 핫플러그 스크립트 실행
# 가상 인터페이스 생성/제거 시 자동으로 스크립트 실행
run_hotplug_scripts=1

# xl 도구 잠금 파일 위치
lockfile="/var/lock/xl"

# 기본 가상 네트워크 인터페이스 설정
vif.default.script="vif-bridge"
vif.default.bridge="xenbr0"

# 기본 가상 블록 디바이스 설정
vbd.default.script="block"

# 도메인 생성 시 기본 설정
# 메모리 단위: MB
domain.default.memory=512
domain.default.maxmem=1024

# 기본 vCPU 수
domain.default.vcpus=1
domain.default.maxvcpus=2

# 도메인 자동 시작 지연 (초)
domain.autorestart.delay=10

# PCI 패스스루 설정 (IOMMU 필요)
# pci.default.rdm_policy="relaxed"

# 로그 레벨 설정
# 0: 오류만, 1: 경고, 2: 정보, 3: 디버그
xl.default.loglevel=1

# 콘솔 설정
console.default.type="pty"

# 클록 소스 설정 (성능 최적화)
# "tsc": TSC 사용 (권장)
# "hpet": HPET 사용
# "pit": PIT 사용 (호환성)
timer_mode="tsc"

# CPU 스케줄러
# "credit": 기본 크레딧 스케줄러
# "credit2": 크레딧2 스케줄러 (멀티코어 최적화)
sched="credit2"

# 전원 관리
# power_mgmt=1

# 키보드/마우스 공유 설정
# keymap="us"

# VNC 디스플레이 기본 설정
vnc.default.listen="127.0.0.1"
vnc.default.display=1

# 네트워크 보안 설정
# network.default.bridge_firewalling=1

# 이벤트 채널 최대 수
evtchn_fifo=1

# 도메인 저장/복원 압축
domain.default.save_compress=1

# 마이그레이션 압축
migrate.default.compress=1

# PV 도메인 허용
pv_shim=1

# 64비트 PV 도메인만 허용 (보안 강화)
# pv.64bit_only=1

# 도메인 충돌 시 동작
# "coredump-destroy": 코어덤프 후 제거
# "coredump-restart": 코어덤프 후 재시작
# "preserve": 상태 보존
# "rename-restart": 이름 변경 후 재시작
on_crash="coredump-destroy"

# 도메인 정상 종료 시 동작
on_poweroff="destroy"

# 도메인 재부팅 시 동작
on_reboot="restart"

# Xen 도구 로그 위치
xl.logdir="/var/log/xen"

# 자동 시작 도메인 디렉토리
autostart.dir="/etc/xen/auto"

# 도메인 생성 시 UUID 자동 생성
uuid.autogen=1

# 메모리 덤프 위치
coredump.dir="/var/lib/xen/dump"

# 사용자 권한 설정
# xl.unprivileged.allow=1

# 네트워크 브릿지 MAC 주소 자동 생성
vif.default.mac_autogen=1

# 시간 동기화
# rtc_timeoffset=0

# 도메인 간 공유 메모리 허용
# grant_tables=1

# 보안 강화 설정
# xsm_policy_file="/etc/xen/xsm-policy.bin"

# 네스티드 가상화 허용 (HVM 도메인)
# nested_hvm=1

# 빈도 분석 보호 (측면 채널 공격 방어)
# spec_ctrl=1

# 마이크로코드 업데이트 허용
# ucode=scan

# NUMA 토폴로지 노출
# numa=on

# CPU 핀닝 기본값
# vcpu_pin_policy="auto"

# 도메인 생성 시 콘솔 자동 연결
console.default.autoconnect=1

# HVM 도메인 기본 펌웨어
# firmware.default="bios"

# 스토리지 기본 형식
# disk.default.format="raw"

# 백엔드 도메인 설정
# backend.default.dom="0"

# 이벤트 로깅
# event_logging=1

# 성능 모니터링
# perfctr_llc=1
# perfctr_ipc=1

# 도메인 생성 제한
# domain.max_count=32

# 메모리 보호 설정
# memory.default.protection="rw"

# CPU 기능 마스킹
# cpuid_mask_ecx=0x00000000
# cpuid_mask_edx=0x00000000

# AMD 전용 설정
# amd_iommu=1

# Intel 전용 설정  
# intel_iommu=1

# 하이퍼바이저 로그 버퍼 크기 (KB)
# conring_size=64

# 게스트 로그 레벨
# guest_loglvl=all

