# GRUB 설정 템플릿 - Ubuntu 22.04/24.04 + Xen 최적화
# /etc/default/grub 파일용 템플릿

# 기본 부팅 항목 (0: 첫 번째, 2>0: Xen 항목)
GRUB_DEFAULT=0

# 부팅 메뉴 표시 시간 (초)
GRUB_TIMEOUT=10

# 부팅 메뉴 숨김 비활성화 (Xen 선택을 위해)
GRUB_TIMEOUT_STYLE=menu

# 배급자 정보
GRUB_DISTRIBUTOR=`lsb_release -i -s 2> /dev/null || echo Debian`

# 기본 커널 명령줄 옵션
# Ubuntu 22.04 기본 설정
GRUB_CMDLINE_LINUX_DEFAULT="quiet splash"

# Ubuntu 24.04 + 드라이버 호환성 설정
# GRUB_CMDLINE_LINUX_DEFAULT="quiet splash nomodeset intel_iommu=on iommu=pt"

# 추가 커널 옵션 (모든 커널에 적용)
GRUB_CMDLINE_LINUX=""

# 터미널 설정
GRUB_TERMINAL=console

# 직렬 콘솔 설정 (원격 관리용)
# GRUB_SERIAL_COMMAND="serial --speed=115200 --unit=0 --word=8 --parity=no --stop=1"
# GRUB_TERMINAL="console serial"

# 그래픽 모드 설정
# GRUB_GFXMODE=640x480
# GRUB_GFXPAYLOAD_LINUX=keep

# 배경 이미지
# GRUB_BACKGROUND="/usr/share/images/grub/apollo17.tga"

# 테마 설정
# GRUB_THEME="/usr/share/grub/themes/ubuntu-mono/theme.txt"

# 복구 모드 비활성화
# GRUB_DISABLE_RECOVERY="true"

# 메모리 테스트 항목 비활성화
# GRUB_DISABLE_MEMTEST="true"

# OS 자동 감지 (다른 OS 부팅 항목)
# GRUB_DISABLE_OS_PROBER=false

# Xen 하이퍼바이저 옵션
# 이 설정들은 xen_reliable_installer.sh에 의해 자동으로 추가됩니다

# ===========================================
# Xen 최적화 설정 (설치 스크립트가 자동 추가)
# ===========================================

# Dom0 메모리 제한 (MB)
# dom0_mem=4096M,max:4096M

# Dom0 최대 vCPU 수
# dom0_max_vcpus=4

# Xen 메모리 할당
# xen.dom0_mem=4096M

# 로깅 옵션
# loglvl=all guest_loglvl=all conring_size=64k

# 하드웨어 지원 페이징 (Intel VT-x/AMD-V)
# hap=1

# IOMMU 설정 (PCI 패스스루용)
# iommu=pt

# Intel IOMMU 활성화
# intel_iommu=on

# AMD IOMMU 활성화  
# amd_iommu=on

# 직렬 콘솔 출력
# console=ttyS0,115200

# VGA 콘솔 출력
# console=tty0

# ===========================================
# 환경별 특수 설정
# ===========================================

# MegaRAID 호환성 (Ubuntu 24.04)
# intel_iommu=on iommu=pt

# AMD 그래픽 호환성 (Ubuntu 24.04)  
# nomodeset

# Secure Boot 환경
# 추가 설정 필요 시 여기에 추가

# 가상화 환경 (중첩 가상화)
# nopti noibrs noibpb

# ===========================================
# 고급 Xen 옵션
# ===========================================

# CPU 스케줄러
# sched=credit2

# 전원 관리
# cpuidle=1 cpufreq=xen

# 보안 강화
# spec_ctrl=1 

# SMT/HT 제어
# smt=on

# PCI 패스스루 정책
# pci_pt_e820_access=on

# 메모리 압축
# tmem=1

# 프로파일링
# oprofile=timer

# NUMA 지원
# numa=on

# CPU 토폴로지
# cpuid_mask_ecx=0 cpuid_mask_edx=0

# ===========================================
# 디버깅 및 개발 옵션
# ===========================================

# 상세 부팅 로그
# loglvl=all debug=y

# 게스트 도메인 디버깅
# guest_loglvl=all

# 하이퍼바이저 디버깅
# console_timestamps=datems

# 메모리 디버깅
# debug_stack=y

# 락 디버깅
# lock_profiling=1

# ===========================================
# 성능 최적화 옵션
# ===========================================

# CPU 핀닝 자동화
# vcpu_pin=1

# 인터럽트 라우팅 최적화
# irq_pal=1

# I/O 스케줄링
# noop elevator

# 메모리 밸런싱
# memory_guard=1

# ===========================================
# 문제 해결 옵션
# ===========================================

# 안전 모드 (최소 기능)
# noacpi nolapic

# 그래픽 문제 해결
# nomodeset vga=normal

# 네트워크 문제 해결
# pci=nomsi

# 타이머 문제 해결
# nohpet clocksource=pit

# ACPI 문제 해결
# acpi=off

# ===========================================
# 백업 및 복구
# ===========================================

# 원본 설정 백업
# 설치 스크립트가 자동으로 /var/backups/xen-installer/에 백업 생성

# 복구 명령어:
# sudo cp /var/backups/xen-installer/grub.backup.* /etc/default/grub
# sudo update-grub

# ===========================================
# 사용 예시
# ===========================================

# 기본 Xen 설정 (자동 적용됨):
# GRUB_CMDLINE_LINUX_DEFAULT="quiet splash dom0_mem=4096M,max:4096M dom0_max_vcpus=4 loglvl=all guest_loglvl=all conring_size=64k hap=1 iommu=pt"

# MegaRAID + AMD 그래픽 환경 (Ubuntu 24.04):
# GRUB_CMDLINE_LINUX_DEFAULT="quiet splash nomodeset intel_iommu=on iommu=pt dom0_mem=4096M,max:4096M dom0_max_vcpus=4 loglvl=all guest_loglvl=all conring_size=64k hap=1"

# 디버깅 모드:
# GRUB_CMDLINE_LINUX_DEFAULT="debug loglvl=all guest_loglvl=all console_timestamps=datems dom0_mem=4096M,max:4096M dom0_max_vcpus=4 hap=1 iommu=pt"

# 성능 최적화 모드:
# GRUB_CMDLINE_LINUX_DEFAULT="quiet dom0_mem=2048M,max:2048M dom0_max_vcpus=2 sched=credit2 cpuidle=1 numa=on hap=1 iommu=pt"